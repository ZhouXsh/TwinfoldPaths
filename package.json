{
  "name": "twinfold-paths",
  "version": "0.1.0",
  "private": true,
  "description": "《双生折线》：手机竖屏、可离线运行的单文件 H5 休闲解谜游戏",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --port 4173 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "validate:levels": "node tools/validate-levels.mjs",
    "solve:levels": "node tools/solve-levels.mjs",
    "test:e2e": "playwright test",
    "build": "vite build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "node scripts/check.mjs",
    "ci": "node scripts/ci.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhouXsh/TwinfoldPaths.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11"
  }
}
