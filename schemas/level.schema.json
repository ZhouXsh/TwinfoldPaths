{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twifold-paths.dev/schemas/level.schema.json",
  "title": "《双生折线》关卡 Schema",
  "description": "版本化 JSON Schema（schemaVersion: 1），与 LevelDef + LevelRecord 及 10 类 Entity 联合类型一致",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "chapter",
    "order",
    "title",
    "grid",
    "blueStart",
    "orangeStart",
    "blueExit",
    "orangeExit",
    "initialMapping",
    "walls",
    "entities",
    "parMoves",
    "hint",
    "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Schema 版本，当前仅支持 1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "关卡唯一标识，如 level-001"
    },
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "description": "所属章节"
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "description": "章内序号"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "关卡标题"
    },
    "grid": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 2, "maximum": 32 },
        "height": { "type": "integer", "minimum": 2, "maximum": 32 }
      },
      "description": "网格尺寸，2..32"
    },
    "blueStart": { "$ref": "#/$defs/point", "description": "蓝色角色起点" },
    "orangeStart": { "$ref": "#/$defs/point", "description": "橙色角色起点" },
    "blueExit": { "$ref": "#/$defs/point", "description": "蓝色出口" },
    "orangeExit": { "$ref": "#/$defs/point", "description": "橙色出口" },
    "initialMapping": {
      "enum": ["H_MIRROR", "V_MIRROR", "ROTATE_CW"],
      "description": "初始映射模式"
    },
    "walls": {
      "type": "array",
      "items": { "$ref": "#/$defs/point" },
      "description": "墙坐标列表"
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" },
      "description": "机关实体列表（不含墙）"
    },
    "parMoves": {
      "type": "integer",
      "minimum": 1,
      "description": "目标步数（星级标准）"
    },
    "parMovesNote": {
      "type": "string",
      "description": "当 parMoves > 最短步数时的偏离理由"
    },
    "hint": {
      "type": "object",
      "required": ["focus"],
      "additionalProperties": false,
      "properties": {
        "focus": { "type": "string", "minLength": 1, "description": "提示文本" },
        "direction": {
          "enum": ["UP", "DOWN", "LEFT", "RIGHT", null],
          "description": "建议方向（可为 null）"
        }
      },
      "description": "关卡提示"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "标签数组，至少包含章节标签与机制标签"
    }
  },
  "allOf": [
    {
      "description": "parMoves > solverOptimal 时 parMovesNote 必填（ADR-003）",
      "if": {
        "properties": {
          "parMovesNote": { "not": { "type": "string" } }
        }
      },
      "then": {
        "properties": {
          "parMoves": { "type": "integer", "minimum": 1 }
        }
      }
    }
  ],
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0, "description": "列坐标（从左到右）" },
        "y": { "type": "integer", "minimum": 0, "description": "行坐标（从上到下）" }
      }
    },
    "entity": {
      "type": "object",
      "required": ["type", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "door",
            "plate",
            "colorDoor",
            "pauseTile",
            "switcher",
            "oneWay",
            "portal",
            "fragile",
            "pulseSwitch",
            "pulseDoor"
          ]
        },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "door" } } },
          "then": {
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "plate" } } },
          "then": {
            "required": ["id", "doorId"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "doorId": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "colorDoor" } } },
          "then": {
            "required": ["color"],
            "properties": {
              "color": { "enum": ["BLUE", "ORANGE"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pauseTile" } } },
          "then": {
            "properties": {}
          }
        },
        {
          "if": { "properties": { "type": { "const": "switcher" } } },
          "then": {
            "required": ["target"],
            "properties": {
              "target": { "enum": ["H_MIRROR", "V_MIRROR", "ROTATE_CW"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "oneWay" } } },
          "then": {
            "required": ["arrow"],
            "properties": {
              "arrow": { "enum": ["UP", "DOWN", "LEFT", "RIGHT"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "portal" } } },
          "then": {
            "required": ["portalId", "end"],
            "properties": {
              "portalId": { "type": "string", "minLength": 1 },
              "end": { "enum": ["A", "B"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "fragile" } } },
          "then": {
            "properties": {}
          }
        },
        {
          "if": { "properties": { "type": { "const": "pulseSwitch" } } },
          "then": {
            "required": ["pairId"],
            "properties": {
              "pairId": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pulseDoor" } } },
          "then": {
            "required": ["pairId"],
            "properties": {
              "pairId": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
